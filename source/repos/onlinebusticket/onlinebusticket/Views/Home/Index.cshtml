@{
    ViewData["Title"] = "Home Page";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>SRC Travel - Bus Reservation System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            overflow-x: hidden;
        }

        /* NAVBAR */
        .navbar {
            background: transparent;
            padding: 20px 60px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            transition: all 0.3s;
        }

            .navbar.scrolled {
                background: linear-gradient(135deg, #1a1a2e, #16213e);
                padding: 12px 60px;
                box-shadow: 0 2px 20px rgba(0,0,0,0.3);
            }

            .navbar .brand {
                color: #e94560;
                font-size: 26px;
                font-weight: bold;
                text-decoration: none;
            }

                .navbar .brand i {
                    margin-right: 8px;
                }

            .navbar .nav-links a {
                color: white;
                text-decoration: none;
                margin-left: 30px;
                font-size: 14px;
                transition: color 0.3s;
                font-weight: 500;
            }

                .navbar .nav-links a:hover {
                    color: #e94560;
                }

            .navbar .nav-links .btn-login {
                background-color: #e94560;
                color: white !important;
                padding: 10px 25px;
                border-radius: 25px;
                margin-left: 15px;
            }

                .navbar .nav-links .btn-login:hover {
                    background-color: #c73652;
                }

        /* HERO */
        .hero {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 120px 20px 80px;
            position: relative;
            overflow: hidden;
        }

            .hero::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle, rgba(233,69,96,0.1) 0%, transparent 60%);
                animation: pulse 4s ease-in-out infinite;
            }
        @@keyframes pulse {
            0%, 100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.1);
            }
        }

        .floating-bus {
            position: absolute;
            font-size: 200px;
            color: rgba(255,255,255,0.03);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation: float 6s ease-in-out infinite;
        }
        @@keyframes float {
            0%, 100% {
                transform: translate(-50%, -50%) translateY(0);
            }

            50% {
                transform: translate(-50%, -50%) translateY(-20px);
            }
        }

        .hero-content {
            max-width: 800px;
            position: relative;
            z-index: 1;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(233,69,96,0.2);
            color: #e94560;
            padding: 8px 20px;
            border-radius: 25px;
            font-size: 13px;
            margin-bottom: 20px;
            border: 1px solid rgba(233,69,96,0.3);
        }

        .hero h1 {
            color: white;
            font-size: 56px;
            font-weight: 800;
            margin-bottom: 20px;
            line-height: 1.2;
        }

            .hero h1 span {
                color: #e94560;
            }

        .hero p {
            color: #aaa;
            font-size: 18px;
            margin-bottom: 50px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        /* SEARCH BOX */
        .search-box {
            background: white;
            border-radius: 20px;
            padding: 35px;
            box-shadow: 0 30px 80px rgba(0,0,0,0.4);
            text-align: left;
        }

            .search-box h5 {
                color: #1a1a2e;
                font-weight: bold;
                margin-bottom: 25px;
                font-size: 18px;
            }

            .search-box .form-label {
                color: #555;
                font-size: 13px;
                font-weight: 600;
            }

            .search-box .form-control, .search-box .form-select {
                border: 2px solid #f0f0f0;
                border-radius: 10px;
                padding: 12px 15px;
                font-size: 14px;
                transition: border 0.3s;
            }

                .search-box .form-control:focus, .search-box .form-select:focus {
                    border-color: #e94560;
                    box-shadow: none;
                }

        .btn-search {
            background: linear-gradient(135deg, #e94560, #c73652);
            color: white;
            border: none;
            padding: 13px 30px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: bold;
            width: 100%;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 5px 20px rgba(233,69,96,0.4);
        }

            .btn-search:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(233,69,96,0.5);
            }

        /* STATS */
        .stats-section {
            background: white;
            padding: 60px 40px;
        }

        .stat-item {
            text-align: center;
        }

            .stat-item .number {
                font-size: 42px;
                font-weight: 800;
                color: #e94560;
            }

            .stat-item .label {
                color: #999;
                font-size: 14px;
                margin-top: 5px;
            }

        /* FEATURES */
        .features-section {
            padding: 100px 40px;
            background: #f4f6f9;
        }

        .section-badge {
            display: inline-block;
            background: rgba(233,69,96,0.1);
            color: #e94560;
            padding: 6px 18px;
            border-radius: 25px;
            font-size: 13px;
            margin-bottom: 15px;
        }

        .section-title {
            font-size: 36px;
            font-weight: 800;
            color: #1a1a2e;
            margin-bottom: 10px;
        }

        .section-subtitle {
            color: #999;
            margin-bottom: 60px;
            font-size: 15px;
        }

        .feature-card {
            background: white;
            border-radius: 15px;
            padding: 35px 25px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            transition: all 0.3s;
            height: 100%;
            border-bottom: 3px solid transparent;
        }

            .feature-card:hover {
                transform: translateY(-8px);
                border-bottom: 3px solid #e94560;
                box-shadow: 0 15px 40px rgba(0,0,0,0.12);
            }

            .feature-card .icon-box {
                width: 70px;
                height: 70px;
                background: linear-gradient(135deg, rgba(233,69,96,0.1), rgba(233,69,96,0.2));
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 20px;
                font-size: 28px;
                color: #e94560;
                transition: all 0.3s;
            }

            .feature-card:hover .icon-box {
                background: linear-gradient(135deg, #e94560, #c73652);
                color: white;
            }

            .feature-card h5 {
                color: #1a1a2e;
                font-weight: 700;
                margin-bottom: 10px;
            }

            .feature-card p {
                color: #999;
                font-size: 14px;
                line-height: 1.6;
            }

        /* ROUTES */
        .routes-section {
            padding: 100px 40px;
            background: white;
        }

        .route-card {
            background: #f9f9f9;
            border-radius: 12px;
            padding: 20px 25px;
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s;
            border-left: 4px solid #e94560;
            cursor: pointer;
        }

            .route-card:hover {
                background: linear-gradient(135deg, #e94560, #c73652);
                transform: translateX(8px);
                box-shadow: 0 10px 30px rgba(233,69,96,0.3);
            }

                .route-card:hover .route-cities,
                .route-card:hover .route-info,
                .route-card:hover .route-price {
                    color: white;
                }

        .route-cities {
            font-weight: 700;
            color: #1a1a2e;
            font-size: 16px;
        }

        .route-info {
            color: #999;
            font-size: 12px;
            margin-top: 3px;
        }

        .route-price {
            color: #e94560;
            font-weight: 800;
            font-size: 20px;
        }

        /* HOW IT WORKS */
        .how-section {
            padding: 100px 40px;
            background: #f4f6f9;
        }

        .step-card {
            text-align: center;
            padding: 30px;
        }

        .step-number {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #e94560, #c73652);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            color: white;
            font-size: 22px;
            font-weight: 800;
            box-shadow: 0 5px 20px rgba(233,69,96,0.4);
        }

        .step-card h5 {
            color: #1a1a2e;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .step-card p {
            color: #999;
            font-size: 14px;
        }

        /* FOOTER */
        .footer {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            color: #aaa;
            padding: 60px 40px 30px;
        }

            .footer .brand {
                color: #e94560;
                font-size: 24px;
                font-weight: bold;
                margin-bottom: 10px;
            }

        .footer-links a {
            color: #aaa;
            text-decoration: none;
            margin: 0 15px;
            font-size: 13px;
        }

            .footer-links a:hover {
                color: #e94560;
            }

        .footer-bottom {
            border-top: 1px solid #ffffff11;
            margin-top: 30px;
            padding-top: 20px;
            font-size: 13px;
        }

        /* COUNTER ANIMATION */
        .counter {
            display: inline-block;
        }
    </style>
</head>
