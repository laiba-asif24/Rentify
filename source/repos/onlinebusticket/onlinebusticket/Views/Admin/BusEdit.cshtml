@model online_bus_ticket.Models.Bus
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Edit Bus - SRC Travel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #1a1a2e;
            color: #eee;
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            background-color: #16213e;
            width: 250px;
            min-height: 100vh;
            padding: 20px;
            position: fixed;
            top: 0;
            left: 0;
            height: 100%;
        }

            .sidebar .brand {
                color: #e94560;
                font-size: 22px;
                font-weight: bold;
                margin-bottom: 30px;
                display: block;
                text-align: center;
                padding-bottom: 20px;
                border-bottom: 1px solid #e9456033;
            }

            .sidebar a {
                color: #aaa;
                display: block;
                padding: 12px 15px;
                border-radius: 8px;
                margin-bottom: 5px;
                text-decoration: none;
                transition: all 0.3s;
            }

                .sidebar a:hover, .sidebar a.active {
                    background-color: #e94560;
                    color: white;
                }

                .sidebar a i {
                    margin-right: 10px;
                    width: 20px;
                }

        .main-content {
            margin-left: 250px;
            padding: 30px;
            width: calc(100% - 250px);
        }

        .top-bar {
            background-color: #16213e;
            padding: 15px 25px;
            border-radius: 10px;
            margin-bottom: 25px;
        }

        .form-card {
            background-color: #16213e;
            border-radius: 15px;
            padding: 30px;
            max-width: 600px;
        }

        .form-label {
            color: #aaa;
            margin-bottom: 5px;
        }

        .form-control, .form-select {
            background-color: #0f3460;
            border: 1px solid #e9456033;
            color: #eee;
            border-radius: 8px;
            padding: 10px 15px;
        }

            .form-control:focus, .form-select:focus {
                background-color: #0f3460;
                border-color: #e94560;
                color: #eee;
                box-shadow: none;
            }

        .btn-save {
            background-color: #e94560;
            color: white;
            border: none;
            padding: 10px 30px;
            border-radius: 8px;
            margin-top: 20px;
        }

            .btn-save:hover {
                background-color: #c73652;
            }

        .btn-back {
            background-color: #0f3460;
            color: #aaa;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            margin-right: 10px;
        }

            .btn-back:hover {
                color: white;
            }
    </style>
</head>
<body>
    <div class="sidebar">
        <span class="brand"><i class="fas fa-bus"></i> SRC Travel</span>
        <a href="/Admin/Dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a href="/Admin/Buses" class="active"><i class="fas fa-bus"></i> Buses</a>
        <a href="/Admin/Employees"><i class="fas fa-users"></i> Employees</a>
        <a href="/Admin/Bookings"><i class="fas fa-ticket-alt"></i> Bookings</a>
        <a href="/Admin/Routes"><i class="fas fa-route"></i> Routes</a>
        <a href="/Admin/Reports"><i class="fas fa-chart-bar"></i> Reports</a>
        <a href="#" onclick="document.getElementById('logoutForm').submit(); return false;"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </div>

    <div class="main-content">
        <div class="top-bar">
            <h4 style="margin:0; color:#e94560;"><i class="fas fa-edit"></i> Edit Bus</h4>
        </div>
        <div class="form-card">
            <form asp-action="BusEdit" asp-controller="Admin" method="post">
                <input asp-for="BusId" type="hidden" />
                <div class="mb-3">
                    <label class="form-label">Bus Number</label>
                    <input asp-for="BusNumber" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Bus Type</label>
                    <select asp-for="BusType" class="form-select">
                        <option value="AC">AC</option>
                        <option value="Non-AC">Non-AC</option>
                        <option value="Sleeper">Sleeper</option>
                        <option value="Mini">Mini</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Total Seats</label>
                    <input asp-for="TotalSeats" class="form-control" type="number" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Status</label>
                    <select asp-for="IsActive" class="form-select">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
                <div>
                    <a href="/Admin/Buses" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>
                    <button type="submit" class="btn-save"><i class="fas fa-save"></i> Update Bus</button>
                </div>
            </form>
        </div>
    </div>
    <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" method="post"></form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>