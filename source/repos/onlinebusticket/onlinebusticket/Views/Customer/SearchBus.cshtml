@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Search Bus - SRC Travel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .navbar {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 20px rgba(0,0,0,0.3);
        }

            .navbar .brand {
                color: #e94560;
                font-size: 22px;
                font-weight: bold;
                text-decoration: none;
            }

            .navbar .nav-links a {
                color: #ddd;
                text-decoration: none;
                margin-left: 20px;
                font-size: 14px;
            }

                .navbar .nav-links a:hover {
                    color: #e94560;
                }

        .btn-logout {
            background-color: #e94560;
            color: white !important;
            padding: 8px 20px;
            border-radius: 25px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            margin-left: 15px;
        }

        .page-header {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            padding: 50px 40px;
            color: white;
            text-align: center;
        }

            .page-header h2 {
                font-size: 32px;
                font-weight: 800;
            }

                .page-header h2 span {
                    color: #e94560;
                }

            .page-header p {
                color: #aaa;
                margin-top: 8px;
            }

        .content {
            padding: 40px;
            max-width: 800px;
            margin: 0 auto;
        }

        .search-card {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        }

        .form-label {
            color: #555;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            display: block;
        }

        .form-select, .form-control {
            border: 2px solid #f0f0f0;
            border-radius: 10px;
            padding: 12px 15px;
            font-size: 14px;
            width: 100%;
        }

            .form-select:focus, .form-control:focus {
                border-color: #e94560;
                box-shadow: none;
                outline: none;
            }

        .btn-search {
            background: linear-gradient(135deg, #e94560, #c73652);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 10px;
            font-size: 16px;
            font-weight: bold;
            width: 100%;
            cursor: pointer;
            margin-top: 10px;
            box-shadow: 0 5px 15px rgba(233,69,96,0.4);
            transition: all 0.3s;
        }

            .btn-search:hover {
                transform: translateY(-2px);
            }
    </style>
</head>
<body>
    <nav class="navbar">
        <a href="/Customer/Dashboard" class="brand"><i class="fas fa-bus"></i> SRC Travel</a>
        <div class="nav-links">
            <a href="/Customer/Dashboard"><i class="fas fa-home"></i> Dashboard</a>
            <a href="/Customer/MyBookings"><i class="fas fa-ticket-alt"></i> My Bookings</a>
            <a href="/Customer/SearchBus"><i class="fas fa-search"></i> Search Bus</a>
            <form asp-area="Identity" asp-page="/Account/Logout" method="post" style="display:inline;">
                <button type="submit" class="btn-logout"><i class="fas fa-sign-out-alt"></i> Logout</button>
            </form>
        </div>
    </nav>

    <div class="page-header">
        <h2>Search <span>Your Bus</span></h2>
        <p>Find available buses for your journey</p>
    </div>

    <div class="content">
        <div class="search-card">
            <form method="get" action="/Customer/SearchResults">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">From</label>
                        <select name="from" class="form-select">
                            <option value="">-- Select City --</option>
                            <option value="Karachi">Karachi</option>
                            <option value="Lahore">Lahore</option>
                            <option value="Islamabad">Islamabad</option>
                            <option value="Peshawar">Peshawar</option>
                            <option value="Quetta">Quetta</option>
                            <option value="Multan">Multan</option>
                            <option value="Faisalabad">Faisalabad</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">To</label>
                        <select name="to" class="form-select">
                            <option value="">-- Select City --</option>
                            <option value="Karachi">Karachi</option>
                            <option value="Lahore">Lahore</option>
                            <option value="Islamabad">Islamabad</option>
                            <option value="Peshawar">Peshawar</option>
                            <option value="Quetta">Quetta</option>
                            <option value="Multan">Multan</option>
                            <option value="Faisalabad">Faisalabad</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Travel Date</label>
                        <input type="date" name="date" class="form-control" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn-search">
                            <i class="fas fa-search"></i> Search Buses
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>