@model IEnumerable<online_bus_ticket.Models.Booking>
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>My Bookings - SRC Travel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .navbar {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 20px rgba(0,0,0,0.3);
        }

            .navbar .brand {
                color: #e94560;
                font-size: 22px;
                font-weight: bold;
                text-decoration: none;
            }

            .navbar .nav-links a {
                color: #ddd;
                text-decoration: none;
                margin-left: 20px;
                font-size: 14px;
            }

                .navbar .nav-links a:hover {
                    color: #e94560;
                }

        .btn-logout {
            background-color: #e94560;
            color: white !important;
            padding: 8px 20px;
            border-radius: 25px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            margin-left: 15px;
        }

        .page-header {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            padding: 40px;
            color: white;
            text-align: center;
        }

            .page-header h2 {
                font-size: 28px;
                font-weight: 800;
            }

                .page-header h2 span {
                    color: #e94560;
                }

        .content {
            padding: 30px 40px;
            max-width: 1100px;
            margin: 0 auto;
        }

        .alert-success {
            background: #e8f5e9;
            border: 1px solid #4CAF50;
            padding: 12px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            color: #2e7d32;
        }

        .booking-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            border-left: 5px solid #e94560;
            transition: all 0.3s;
        }

            .booking-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            }

        .booking-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .route-title {
            font-size: 20px;
            font-weight: 800;
            color: #1a1a2e;
        }

            .route-title i {
                color: #e94560;
                margin-right: 5px;
            }

        .booking-info {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid #f0f0f0;
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
        }

        .info-item {
            color: #666;
            font-size: 13px;
        }

            .info-item i {
                color: #e94560;
                margin-right: 5px;
            }

        .badge-confirmed {
            background: #e8f5e9;
            color: #4CAF50;
            padding: 6px 15px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        .badge-pending {
            background: #fff8e1;
            color: #f5a623;
            padding: 6px 15px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        .badge-cancelled {
            background: #ffebee;
            color: #f44336;
            padding: 6px 15px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        .price {
            font-size: 24px;
            font-weight: 800;
            color: #e94560;
        }

        .btn-cancel {
            background: #ffebee;
            color: #f44336;
            border: 1px solid #f44336;
            padding: 8px 20px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.3s;
        }

            .btn-cancel:hover {
                background: #f44336;
                color: white;
            }

        .no-bookings {
            text-align: center;
            padding: 80px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
        }

            .no-bookings i {
                font-size: 60px;
                color: #ddd;
                margin-bottom: 20px;
            }

            .no-bookings h5 {
                color: #999;
            }

        .btn-search-now {
            background: linear-gradient(135deg, #e94560, #c73652);
            color: white;
            padding: 12px 30px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            margin-top: 15px;
            display: inline-block;
            transition: all 0.3s;
        }

            .btn-search-now:hover {
                transform: translateY(-2px);
                color: white;
            }
    </style>
</head>
<body>
    <nav class="navbar">
        <a href="/Customer/Dashboard" class="brand"><i class="fas fa-bus"></i> SRC Travel</a>
        <div class="nav-links">
            <a href="/Customer/Dashboard"><i class="fas fa-home"></i> Dashboard</a>
            <a href="/Customer/MyBookings"><i class="fas fa-ticket-alt"></i> My Bookings</a>
            <a href="/Home/Search"><i class="fas fa-search"></i> Search Bus</a>
            <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" method="post" style="display:inline;">
                <button type="submit" class="btn-logout"><i class="fas fa-sign-out-alt"></i> Logout</button>
            </form>
        </div>
    </nav>

    <div class="page-header">
        <h2>My <span>Bookings</span></h2>
        <p style="color:#aaa; margin-top:5px;">All your travel history</p>
    </div>

    <div class="content">
        @if (TempData["Success"] != null)
        {
            <div class="alert-success">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
            </div>
        }

        @if (Model.Any())
        {
            @foreach (var booking in Model)
            {
                <div class="booking-card">
                    <div class="booking-top">
                        <div>
                            <div class="route-title">
                                <i class="fas fa-map-marker-alt"></i>
                                @booking.BusSchedule?.Route?.SourceCity → @booking.BusSchedule?.Route?.DestinationCity
                            </div>
                            <div style="color:#999; font-size:13px; margin-top:5px;">
                                Booking #@booking.BookingId • @booking.BookingDate.ToString("dd MMM yyyy")
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="price">Rs. @booking.TotalAmount</div>
                            <div style="margin-top:8px;">
                                @if (booking.Status == "Confirmed")
                                {
                                    <span class="badge-confirmed"><i class="fas fa-check"></i> Confirmed</span>
                                }
                                else if (booking.Status == "Pending")
                                {

                                    <span class="badge-pending"><i class="fas fa-clock"></i> Pending</span>
                                }
                                else
                                {

                                    <span class="badge-cancelled"><i class="fas fa-times"></i> Cancelled</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="booking-info">
                        <div>
                            <span class="info-item"><i class="fas fa-bus"></i> @booking.BusSchedule?.Bus?.BusNumber</span>
                            &nbsp;&nbsp;
                            <span class="info-item"><i class="fas fa-clock"></i> @booking.BusSchedule?.DepartureTime.ToString("dd MMM yyyy hh:mm tt")</span>
                            &nbsp;&nbsp;
                            <span class="info-item"><i class="fas fa-road"></i> @booking.BusSchedule?.Route?.DistanceKM KM</span>
                        </div>
                        @if (booking.Status != "Cancelled")
                        {
                            <a href="/Customer/CancelBooking/@booking.BookingId" class="btn-cancel">
                                <i class="fas fa-times-circle"></i> Cancel
                            </a>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-bookings">
                <div><i class="fas fa-ticket-alt"></i></div>
                <h5>No bookings yet!</h5>
                <p style="color:#bbb; margin-top:10px;">Search for buses and book your journey!</p>
                <a href="/Home/Search" class="btn-search-now">
                    <i class="fas fa-search"></i> Search Buses Now
                </a>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
</html>