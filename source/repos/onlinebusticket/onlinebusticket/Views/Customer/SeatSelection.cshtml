@model online_bus_ticket.Models.BusSchedule
@{
    Layout = null;
    var totalSeats = Model?.Bus?.TotalSeats ?? 40;
}
<!DOCTYPE html>
<html>
<head>
    <title>Seat Selection - SRC Travel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .navbar {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 20px rgba(0,0,0,0.3);
        }

            .navbar .brand {
                color: #e94560;
                font-size: 22px;
                font-weight: bold;
                text-decoration: none;
            }

            .navbar .nav-links a {
                color: #ddd;
                text-decoration: none;
                margin-left: 20px;
                font-size: 14px;
            }

        .page-header {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            padding: 40px;
            color: white;
            text-align: center;
        }

            .page-header h2 {
                font-size: 28px;
                font-weight: 800;
            }

                .page-header h2 span {
                    color: #e94560;
                }

        .content {
            padding: 30px 40px;
            max-width: 1100px;
            margin: 0 auto;
        }

        .bus-info-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            margin-bottom: 25px;
            border-left: 5px solid #e94560;
        }

        .bus-route {
            font-size: 22px;
            font-weight: 800;
            color: #1a1a2e;
        }

        .bus-details {
            display: flex;
            gap: 20px;
            margin-top: 10px;
            flex-wrap: wrap;
        }

        .detail-item {
            color: #666;
            font-size: 13px;
        }

            .detail-item i {
                color: #e94560;
                margin-right: 5px;
            }

        .seat-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            margin-bottom: 25px;
        }

            .seat-card h5 {
                color: #1a1a2e;
                font-weight: 700;
                margin-bottom: 20px;
            }

        .legend {
            display: flex;
            gap: 20px;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #666;
        }

        .legend-box {
            width: 35px;
            height: 35px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

            .legend-box.available {
                background: #f0f0f0;
                border: 2px solid #ddd;
            }

            .legend-box.booked {
                background: #ffebee;
                border: 2px solid #f44336;
                color: #f44336;
            }

            .legend-box.selected {
                background: #e94560;
                border: 2px solid #c73652;
                color: white;
            }

        .bus-layout {
            background: #f9f9f9;
            border-radius: 15px;
            padding: 20px;
            max-width: 420px;
            margin: 0 auto;
        }

        .bus-front {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            border-radius: 10px 10px 0 0;
            padding: 12px;
            text-align: center;
            color: white;
            font-size: 13px;
            margin-bottom: 15px;
        }

        .seat-row {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-bottom: 8px;
            align-items: center;
        }

        .aisle {
            width: 25px;
        }

        .seat {
            width: 40px;
            height: 40px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            border: 2px solid #ddd;
            background: #f0f0f0;
            color: #666;
            transition: all 0.2s;
        }

            .seat:hover {
                background: #ffd6dc;
                border-color: #e94560;
            }

            .seat.booked {
                background: #ffebee;
                border-color: #f44336;
                color: #f44336;
                cursor: not-allowed;
            }

            .seat.selected {
                background: #e94560;
                border-color: #c73652;
                color: white;
            }

        .summary-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            position: sticky;
            top: 20px;
        }

            .summary-card h5 {
                color: #1a1a2e;
                font-weight: 700;
                margin-bottom: 20px;
            }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 14px;
        }

            .summary-row .label {
                color: #666;
            }

            .summary-row .value {
                color: #1a1a2e;
                font-weight: 600;
            }

        .total-row {
            border-top: 2px solid #f0f0f0;
            padding-top: 12px;
            margin-top: 5px;
        }

            .total-row .label {
                color: #1a1a2e;
                font-weight: 700;
                font-size: 16px;
            }

            .total-row .value {
                color: #e94560;
                font-weight: 800;
                font-size: 20px;
            }

        .btn-confirm {
            background: linear-gradient(135deg, #e94560, #c73652);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: bold;
            width: 100%;
            cursor: pointer;
            margin-top: 15px;
            box-shadow: 0 5px 15px rgba(233,69,96,0.4);
            transition: all 0.3s;
        }

            .btn-confirm:hover {
                transform: translateY(-2px);
            }

            .btn-confirm:disabled {
                background: #ccc;
                box-shadow: none;
                cursor: not-allowed;
                transform: none;
            }
    </style>
</head>
<body>

    <nav class="navbar">
        <a href="/Customer/Dashboard" class="brand"><i class="fas fa-bus"></i> SRC Travel</a>
        <div class="nav-links">
            <a href="/Customer/Dashboard"><i class="fas fa-home"></i> Dashboard</a>
            <a href="/Customer/MyBookings"><i class="fas fa-ticket-alt"></i> My Bookings</a>
        </div>
    </nav>

    <div class="page-header">
        <h2>Select Your <span>Seat</span></h2>
        <p style="color:#aaa; margin-top:5px;">Choose your preferred seat</p>
    </div>

    <div class="content">
        <div class="bus-info-card">
            <div class="bus-route">
                <i class="fas fa-map-marker-alt" style="color:#e94560;"></i>
                @Model?.Route?.SourceCity → @Model?.Route?.DestinationCity
            </div>
            <div class="bus-details">
                <span class="detail-item"><i class="fas fa-bus"></i> @Model?.Bus?.BusNumber</span>
                <span class="detail-item"><i class="fas fa-couch"></i> @Model?.Bus?.BusType</span>
                <span class="detail-item"><i class="fas fa-clock"></i> @Model?.DepartureTime.ToString("dd MMM yyyy hh:mm tt")</span>
                <span class="detail-item"><i class="fas fa-arrow-right"></i> @Model?.ArrivalTime.ToString("hh:mm tt")</span>
                <span class="detail-item"><i class="fas fa-tag"></i> Rs. @Model?.Fare per seat</span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="seat-card">
                    <h5><i class="fas fa-chair" style="color:#e94560;"></i> Bus Seat Map</h5>
                    <div class="legend">
                        <div class="legend-item">
                            <div class="legend-box available"><i class="fas fa-chair"></i></div>
                            Available
                        </div>
                        <div class="legend-item">
                            <div class="legend-box booked"><i class="fas fa-times"></i></div>
                            Booked
                        </div>
                        <div class="legend-item">
                            <div class="legend-box selected"><i class="fas fa-check"></i></div>
                            Selected
                        </div>
                    </div>

                    <div class="bus-layout">
                        <div class="bus-front">
                            <i class="fas fa-steering-wheel"></i> Driver
                        </div>
                        @{
                            var bookedSeats = ViewBag.BookedSeats as List<int> ?? new List<int>();
                            int seatNum = 1;
                            int rows = (int)Math.Ceiling(totalSeats / 4.0);
                        }
                        @for (int row = 0; row < rows; row++)
                        {
                            <div class="seat-row">
                                @for (int col = 0; col < 4; col++)
                                {
                                    if (col == 2)
                                    {
                                        <div class="aisle"></div>
                                    }
                                    if (seatNum <= totalSeats)
                                    {
                                        var isBooked = bookedSeats.Contains(seatNum);
                                        var seatClass = isBooked ? "seat booked" : "seat";
                                        var seatNumCopy = seatNum;
                                        <div class="@seatClass"
                                             id="seat_@seatNumCopy"
                                             onclick="@(isBooked ? "" : $"selectSeat({seatNumCopy})")">
                                            @seatNum
                                        </div>
                                        seatNum++;
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="summary-card">
                    <h5><i class="fas fa-receipt" style="color:#e94560;"></i> Booking Summary</h5>
                    <div class="summary-row">
                        <span class="label">Route</span>
                        <span class="value">@Model?.Route?.SourceCity → @Model?.Route?.DestinationCity</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">Date</span>
                        <span class="value">@Model?.DepartureTime.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">Bus</span>
                        <span class="value">@Model?.Bus?.BusNumber</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">Selected Seats</span>
                        <span class="value" id="selectedSeatsDisplay">None</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">Fare per seat</span>
                        <span class="value">Rs. @Model?.Fare</span>
                    </div>
                    <div class="summary-row total-row">
                        <span class="label">Total</span>
                        <span class="value" id="totalAmount">Rs. 0</span>
                    </div>

                    <form method="post" action="/Customer/BookingConfirm">
                        <input type="hidden" name="scheduleId" value="@Model?.ScheduleId" />
                        <input type="hidden" name="selectedSeats" id="selectedSeatsInput" />
                        <input type="hidden" name="totalAmount" id="totalAmountInput" />
                        <button type="submit" class="btn-confirm" id="confirmBtn" disabled>
                            <i class="fas fa-check-circle"></i> Confirm Booking
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        var selectedSeats = [];
        var farePerSeat = @Model?.Fare;

        function selectSeat(seatNum) {
            var seat = document.getElementById('seat_' + seatNum);
            var index = selectedSeats.indexOf(seatNum);
            if (index === -1) {
                selectedSeats.push(seatNum);
                seat.classList.add('selected');
            } else {
                selectedSeats.splice(index, 1);
                seat.classList.remove('selected');
            }
            updateSummary();
        }

        function updateSummary() {
            var total = selectedSeats.length * farePerSeat;
            document.getElementById('selectedSeatsDisplay').textContent =
                selectedSeats.length > 0 ? selectedSeats.sort((a,b)=>a-b).join(', ') : 'None';
            document.getElementById('totalAmount').textContent = 'Rs. ' + total;
            document.getElementById('selectedSeatsInput').value = selectedSeats.join(',');
            document.getElementById('totalAmountInput').value = total;
            document.getElementById('confirmBtn').disabled = selectedSeats.length === 0;
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>