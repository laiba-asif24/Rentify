@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Register - SRC Travel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        }

        .left-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px;
            color: white;
        }

            .left-panel .brand {
                font-size: 36px;
                font-weight: bold;
                color: #e94560;
                margin-bottom: 10px;
            }

                .left-panel .brand i {
                    margin-right: 10px;
                }

            .left-panel p {
                color: #aaa;
                font-size: 16px;
                text-align: center;
                max-width: 350px;
                line-height: 1.6;
            }

            .left-panel .features {
                margin-top: 40px;
                width: 100%;
                max-width: 350px;
            }

        .feature-item {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            color: #ddd;
        }

            .feature-item i {
                color: #e94560;
                font-size: 20px;
                margin-right: 15px;
                width: 25px;
            }

        .right-panel {
            width: 480px;
            background: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 50px 40px;
        }

        .register-title {
            font-size: 28px;
            font-weight: bold;
            color: #1a1a2e;
            margin-bottom: 5px;
        }

        .register-subtitle {
            color: #999;
            font-size: 14px;
            margin-bottom: 30px;
        }

        .form-label {
            color: #555;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .form-control {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 14px;
            color: #333;
        }

            .form-control:focus {
                border-color: #e94560;
                box-shadow: 0 0 0 0.2rem rgba(233,69,96,0.15);
            }

        .btn-register {
            background-color: #e94560;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: bold;
            width: 100%;
            cursor: pointer;
            margin-top: 10px;
            transition: background 0.3s;
        }

            .btn-register:hover {
                background-color: #c73652;
            }

        .login-link {
            text-align: center;
            margin-top: 20px;
            font-size: 14px;
            color: #666;
        }

            .login-link a {
                color: #e94560;
                text-decoration: none;
                font-weight: bold;
            }

                .login-link a:hover {
                    text-decoration: underline;
                }

        .error-text {
            color: #e94560;
            font-size: 12px;
        }

        .alert-danger-custom {
            background: #ffebee;
            border: 1px solid #f44336;
            color: #c62828;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 13px;
        }
    </style>
</head>
<body>

    <!-- Left Panel -->
    <div class="left-panel">
        <div class="brand"><i class="fas fa-bus"></i> SRC Travel</div>
        <p>Join Pakistan's most reliable bus reservation system today!</p>

        <div class="features">
            <div class="feature-item">
                <i class="fas fa-user-plus"></i>
                <span>Free Registration</span>
            </div>
            <div class="feature-item">
                <i class="fas fa-ticket-alt"></i>
                <span>Easy Online Booking</span>
            </div>
            <div class="feature-item">
                <i class="fas fa-history"></i>
                <span>Booking History</span>
            </div>
            <div class="feature-item">
                <i class="fas fa-shield-alt"></i>
                <span>Secure & Safe Travel</span>
            </div>
        </div>
    </div>

    <!-- Right Panel -->
    <div class="right-panel">
        <div class="register-title">Create Account</div>
        <div class="register-subtitle">Fill in the details to get started</div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-danger-custom">
                <i class="fas fa-exclamation-circle"></i>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="alert-danger-custom"></div>

            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input asp-for="Input.Email" name="FullName" class="form-control" placeholder="Enter your full name" />
            </div>

            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input asp-for="Input.Email" class="form-control" placeholder="Enter your email" />
                <span asp-validation-for="Input.Email" class="error-text"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="Min 8 chars, 1 uppercase, 1 number" />
                <span asp-validation-for="Input.Password" class="error-text"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Confirm Password</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" placeholder="Confirm your password" />
                <span asp-validation-for="Input.ConfirmPassword" class="error-text"></span>
            </div>

            <button type="submit" class="btn-register">
                <i class="fas fa-user-plus"></i> Create Account
            </button>
        </form>

        <div class="login-link">
            Already have an account? <a href="/Identity/Account/Login">Login here</a>
        </div>
        <div class="text-center mt-3">
            <a href="/Home/Index" style="color:#999; font-size:13px; text-decoration:none;">
                <i class="fas fa-arrow-left"></i> Back to Home
            </a>
        </div>
    </div>

</body>
</html>