@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Login - SRC Travel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        }

        .left-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px;
            color: white;
        }

            .left-panel .brand {
                font-size: 36px;
                font-weight: bold;
                color: #e94560;
                margin-bottom: 10px;
            }

                .left-panel .brand i {
                    margin-right: 10px;
                }

            .left-panel p {
                color: #aaa;
                font-size: 16px;
                text-align: center;
                max-width: 350px;
                line-height: 1.6;
            }

            .left-panel .features {
                margin-top: 40px;
                width: 100%;
                max-width: 350px;
            }

        .feature-item {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            color: #ddd;
        }

            .feature-item i {
                color: #e94560;
                font-size: 20px;
                margin-right: 15px;
                width: 25px;
            }

        .right-panel {
            width: 480px;
            background: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 50px 40px;
        }

        .login-title {
            font-size: 28px;
            font-weight: bold;
            color: #1a1a2e;
            margin-bottom: 5px;
        }

        .login-subtitle {
            color: #999;
            font-size: 14px;
            margin-bottom: 35px;
        }

        .form-label {
            color: #555;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .form-control {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 14px;
            color: #333;
        }

            .form-control:focus {
                border-color: #e94560;
                box-shadow: 0 0 0 0.2rem rgba(233,69,96,0.15);
            }

        .input-group-text {
            background: #f9f9f9;
            border: 1px solid #e0e0e0;
            border-radius: 8px 0 0 8px;
            color: #999;
        }

        .btn-login {
            background-color: #e94560;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: bold;
            width: 100%;
            cursor: pointer;
            margin-top: 10px;
            transition: background 0.3s;
        }

            .btn-login:hover {
                background-color: #c73652;
            }

        .divider {
            text-align: center;
            color: #ccc;
            margin: 20px 0;
            font-size: 13px;
            position: relative;
        }

            .divider::before, .divider::after {
                content: '';
                position: absolute;
                top: 50%;
                width: 42%;
                height: 1px;
                background: #e0e0e0;
            }

            .divider::before {
                left: 0;
            }

            .divider::after {
                right: 0;
            }

        .register-link {
            text-align: center;
            margin-top: 20px;
            font-size: 14px;
            color: #666;
        }

            .register-link a {
                color: #e94560;
                text-decoration: none;
                font-weight: bold;
            }

                .register-link a:hover {
                    text-decoration: underline;
                }

        .alert-danger-custom {
            background: #ffebee;
            border: 1px solid #f44336;
            color: #c62828;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 13px;
        }

        .form-check-input:checked {
            background-color: #e94560;
            border-color: #e94560;
        }
    </style>
</head>
<body>

    <!-- Left Panel -->
    <div class="left-panel">
        <div class="brand"><i class="fas fa-bus"></i> SRC Travel</div>
        <p>Pakistan's most reliable bus reservation system - Book your journey with ease!</p>

        <div class="features">
            <div class="feature-item">
                <i class="fas fa-ticket-alt"></i>
                <span>Easy Online Booking</span>
            </div>
            <div class="feature-item">
                <i class="fas fa-route"></i>
                <span>Multiple Routes Available</span>
            </div>
            <div class="feature-item">
                <i class="fas fa-chair"></i>
                <span>Seat Selection</span>
            </div>
            <div class="feature-item">
                <i class="fas fa-shield-alt"></i>
                <span>Secure & Safe Travel</span>
            </div>
        </div>
    </div>

    <!-- Right Panel -->
    <div class="right-panel">
        <div class="login-title">Welcome Back!</div>
        <div class="login-subtitle">Please login to your account</div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-danger-custom">
                <i class="fas fa-exclamation-circle"></i>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert-danger-custom" style="display:none"></div>

            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input asp-for="Input.Email" class="form-control" placeholder="Enter your email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="Enter your password" />
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input asp-for="Input.RememberMe" class="form-check-input" type="checkbox" />
                    <label class="form-check-label" style="font-size:13px; color:#666;">Remember me</label>
                </div>
                <a href="/Identity/Account/ForgotPassword" style="font-size:13px; color:#e94560; text-decoration:none;">
                    Forgot Password?
                </a>
            </div>

            <button type="submit" class="btn-login">
                <i class="fas fa-sign-in-alt"></i> Login
            </button>
        </form>

        <div class="register-link">
            Don't have an account? <a href="/Identity/Account/Register">Register here</a>
        </div>
        <div class="text-center mt-3">
            <a href="/Home/Index" style="color:#999; font-size:13px; text-decoration:none;">
                <i class="fas fa-arrow-left"></i> Back to Home
            </a>
        </div>
    </div>

</body>
</html>